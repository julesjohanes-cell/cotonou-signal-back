# Copier en .env (cp .env.example .env). Le fichier .env n'est JAMAIS commité.
# Toutes ces valeurs ont une valeur par défaut adaptée au développement : le fichier .env est facultatif.
# Après modification de .env : docker compose up -d   (recrée le conteneur, voir docs/dev-environment.md)

# Port de l'API sur votre machine (changer si 8000 est déjà utilisé)
WEB_PORT=8000

# --- Django ---
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-me
# Développement seulement. Ajouter l'adresse du tunnel (ngrok...) si besoin.
ALLOWED_HOSTS=*
# Adresses du front autorisées à appeler l'API (séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Pour se connecter à l'admin via un tunnel HTTPS (ngrok...), ajouter ici son adresse complète
CSRF_TRUSTED_ORIGINS=
# Base du lien de capture envoyé aux citoyens (parcours WhatsApp)
FRONT_URL=http://localhost:3000

# --- Démonstration ---
# Crée les comptes agents et quelques signalements FICTIFS au démarrage (jamais en production)
SEED_DEMO=true
DEMO_ADMIN_PASSWORD=admin1234
DEMO_AGENT_PASSWORD=agent1234

# --- Règles de vérification (voir docs/verification.md) ---
GPS_MAX_ACCURACY_M=50
MAX_DISTANCE_M=100
DUPLICATE_RADIUS_M=30
DUPLICATE_DAYS=30
AI_MIN_CONFIDENCE=0.6
AI_TIMEOUT_S=15
CAPTURE_TOKEN_TTL_MIN=10
MAX_PHOTO_MB=8
# false pendant le développement ; true pour exiger un lien de capture valide
REQUIRE_CAPTURE_TOKEN=false
# Zone provisoire de Cotonou : min_lng,min_lat,max_lng,max_lat (À VÉRIFIER, remplacée par un vrai polygone via `load_zone`)
COTONOU_BBOX=2.30,6.32,2.52,6.45

# --- Limitation de débit (requêtes par minute et par adresse IP) ---
THROTTLE_REPORTS=60/min
THROTTLE_CAPTURE=30/min

# --- Modèle de vision ---
# mock : verdict prévisible, aucune clé nécessaire. live : appelle le vrai modèle (à brancher par l'équipe 5)
VERIFY_MODE=mock
VISION_API_KEY=

# --- WhatsApp ---
# mock : les messages sortants sont écrits dans les logs, la signature n'est pas exigée. live : tout est réel
WHATSAPP_MODE=mock
WHATSAPP_VERIFY_TOKEN=cotonou-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Clé qui sert à calculer l'identifiant anonyme (HMAC) d'un numéro de téléphone
REPORTER_HMAC_KEY=dev-only-change-me
