{
  "name": "sandbos-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo SandBos - Frontend Next.js & Backend Django REST Framework",
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "bash -c 'cd backend && venv/bin/python manage.py runserver 0.0.0.0:8000'",
    "build:frontend": "npm run build --prefix frontend",
    "lint:frontend": "npm run lint --prefix frontend",
    "migrate:backend": "bash -c 'cd backend && venv/bin/python manage.py migrate'",
    "check:backend": "bash -c 'cd backend && venv/bin/python manage.py check'"
  }
}
